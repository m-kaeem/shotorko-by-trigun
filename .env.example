# Copy this file to .env (same folder) and fill in your own values. .env is never committed.

# dry_run = log messages to the outbox, send nothing (default)
# android = send real SMS through the Android phone running "SMS Gateway for Android" (local server mode)
SMS_MODE=dry_run

# Shown in the phone app under "Local server" once it is switched on, e.g. http://192.168.0.105:8080
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Demo safety: send EVERY message to this one number instead of the ward officers (your own phone).
# Leave empty to use the numbers in data/ward_contacts.csv.
SMS_OVERRIDE_TO=

# Seconds to wait between messages (Android limits how fast an app may send SMS)
SMS_PAUSE_SECONDS=2
