# Copy this file to .env (same folder) and fill in your own values. .env is never committed.

# dry_run = log messages to the outbox, send nothing (default)
# android = send real SMS through the Android phone running "SMS Gateway for Android" (local server mode)
SMS_MODE=dry_run

# Route 1, CLOUD (works from any network): turn on "Cloud server" in the phone app and copy its
# username and password here. Shotorko then reaches the phone through the free relay api.sms-gate.app,
# wherever either of them is. Needs internet on both sides.
SMS_CLOUD_USER=
SMS_CLOUD_PASS=
# SMS_CLOUD_URL=https://api.sms-gate.app/3rdparty/v1   (default; change only for a private relay server)

# Route 2, LOCAL (same Wi-Fi or the phone's hotspot, no internet needed): shown under "Local server",
# e.g. http://192.168.0.105:8080. If both routes are set, cloud is tried first and local is the backup.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Demo safety: send EVERY message to this one number instead of the ward officers (your own phone).
# Leave empty to use the numbers in data/ward_contacts.csv.
SMS_OVERRIDE_TO=

# Seconds to wait between messages (Android limits how fast an app may send SMS)
SMS_PAUSE_SECONDS=2
